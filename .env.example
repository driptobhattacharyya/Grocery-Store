# Template for environment variables. Nothing loads a .env file automatically:
# copy it to .env (never commit it) and pass it with `docker run --env-file .env`,
# or export the values into your shell (`set -a; . ./.env; set +a`) before
# starting the app. On a host, set them in its dashboard instead.
# Everything is optional for local development; the app runs with no env at all.

# --- Environment -------------------------------------------------------------
# "production" makes the app refuse to start unless SECRET_KEY and JWT_SECRET_KEY
# (and, with DEMO_MODE=false, ADMIN_PASSWORD) are set to real values; also enables
# HSTS and proxy handling. The Docker image sets APP_ENV=production. Default: development.
APP_ENV=development

# --- Secrets (required when APP_ENV=production) -----------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=
# Admin login (/admin/login) when DEMO_MODE=false. Dev default: admin / password.
# In production with DEMO_MODE=false: at least 8 characters and not "password".
# With DEMO_MODE=true (default) this is ignored: see DEMO_ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Demo mode (one private database "sandbox" per visitor) -------------------
# true (default): every API request except /api/health, /api/ready and
# POST /api/demo/session needs an `X-Sandbox-Id` header naming the visitor's
# sandbox (410 sandbox_expired otherwise). false: one shared DATABASE_PATH,
# as before, and the /api/demo/* endpoints answer 404.
DEMO_MODE=true
# Directory of the sandbox databases (<id>.db) and, by default, the template.
# Default: ./data/sandboxes. Ephemeral disks are fine: sandboxes are disposable.
SANDBOX_DIR=./data/sandboxes
# Template database (schema + seed) that sandboxes are copied from; rebuilt at
# every start. Default: <SANDBOX_DIR>/template.db
TEMPLATE_DB_PATH=
# Idle time after which a sandbox is deleted (refreshed on every request).
SANDBOX_TTL_MINUTES=60
# Most sandboxes kept at once; creating one beyond that evicts the least recently used.
SANDBOX_MAX=200
# Password of the "admin" account inside every sandbox. Public on purpose (the
# demo UI shows it); unrelated to ADMIN_PASSWORD. Default: admin1234
DEMO_ADMIN_PASSWORD=admin1234
# Per-IP limits for POST /api/demo/session (sandbox creation) and POST /api/demo/sql.
DEMO_SESSION_RATE_LIMIT=20 per hour
DEMO_SQL_RATE_LIMIT=20 per minute

# --- Auth -------------------------------------------------------------------
# Lifetime of login tokens, in hours. Default: 12.
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12
# Limit for POST /api/login, /api/admin/login and /api/signup, per client IP.
AUTH_RATE_LIMIT=10 per minute; 100 per hour
# Set to false to disable rate limiting (e.g. in tests). Default: true.
RATELIMIT_ENABLED=true
# Where rate-limit counters live. Default: REDIS_URL if set, else memory://
RATELIMIT_STORAGE_URI=

# --- Networking -------------------------------------------------------------
# Port gunicorn listens on (Render and most hosts set this). Default: 8000
# (5000 for `python app.py`).
PORT=8000
# Reverse proxies in front of the app whose X-Forwarded-For/-Proto headers are
# trusted. Default: 1 in production (Render), 0 otherwise. Set 0 for
# `docker run` or a VPS without a reverse proxy, or clients can spoof their IP
# to dodge rate limits.
TRUSTED_PROXY_COUNT=
# Largest accepted request body, in bytes (larger ones get a 413).
# Default: 1048576 (1 MB).
MAX_CONTENT_LENGTH=
# Proxy IPs gunicorn trusts for X-Forwarded-Proto. Default: *
FORWARDED_ALLOW_IPS=*
# Comma-separated origins allowed to call the API cross-origin (the Cloudflare
# frontend, e.g. https://grocery-store.driptobhattacharyya.com). Allowed request
# headers: Authorization, Content-Type, X-Sandbox-Id; Content-Disposition is
# exposed. Only needed if the frontend is hosted separately. Default: unset.
CORS_ORIGINS=
# Override the default Content-Security-Policy header. Default: unset.
CONTENT_SECURITY_POLICY=

# --- Storage ----------------------------------------------------------------
# SQLite file, created and seeded with demo data if missing.
# Default: ./data/grocery.db. Free hosting disks are ephemeral; mount a
# volume and point this at it to keep data.
DATABASE_PATH=./data/grocery.db
# Seconds to wait for a SQLite lock before failing. Default: 15.
SQLITE_BUSY_TIMEOUT=15
# Built Vue app served by Flask. Default: ./frontend/dist
FRONTEND_DIST=

# --- Redis / Celery (optional) ----------------------------------------------
# Enables the Redis cache, shared rate-limit and e-mail counters, and the Celery
# broker. With it set, supervisor.py (the Docker CMD) also starts a Celery worker
# next to gunicorn and e-mail jobs run there; without it they run on a thread
# inside the web process. Default: unset.
REDIS_URL=
# Override Celery's broker URL. Default: REDIS_URL. (Task results are not stored;
# job status lives in each sandbox's `jobs` table. There is no Celery beat schedule.)
CELERY_BROKER_URL=
# How jobs run: celery | thread | inline. Default: celery with REDIS_URL, else thread.
JOBS_EXECUTION=

# --- E-mail for the demo's background jobs -------------------------------------
# Resend over HTTPS (Render's free tier blocks SMTP). Without RESEND_API_KEY the app
# is in "preview" mode: e-mails are rendered into the sandbox outbox, nothing is sent.
RESEND_API_KEY=
EMAIL_FROM=Grocery Store Demo <demo@mail.driptobhattacharyya.com>
# Kill switch: false makes every job fail with "e-mail disabled".
EMAIL_ENABLED=true
# Daily limits (UTC day), counted when a job is enqueued and shared by all sandboxes
# (stored in Redis if REDIS_URL is set, else in process memory).
EMAIL_RECIPIENT_DAILY_LIMIT=5
EMAIL_IP_DAILY_LIMIT=10
EMAIL_DAILY_CAP=80
# Per-IP request limits for POST /api/demo/email and POST /api/demo/jobs.
DEMO_EMAIL_RATE_LIMIT=20 per hour
DEMO_JOBS_RATE_LIMIT=30 per hour
# Cloudflare Turnstile: when set, POST /api/demo/email must carry a valid turnstile_token.
TURNSTILE_SECRET_KEY=
# Local testing only: EMAIL_BACKEND=smtp sends through SMTP_HOST/SMTP_PORT (e.g. MailHog
# on localhost:1025) instead of Resend. Optional: SMTP_USE_TLS, SMTP_USERNAME, SMTP_PASSWORD.
EMAIL_BACKEND=
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Gunicorn / logging -----------------------------------------------------
# Keep 1 worker unless REDIS_URL is set (see gunicorn.conf.py).
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
# DEBUG, INFO, WARNING, ERROR. Default: INFO.
LOG_LEVEL=INFO
# `python app.py` only: 1 enables the debugger/reloader. Default: 1 in
# development, 0 in production. Never used by gunicorn.
FLASK_DEBUG=
