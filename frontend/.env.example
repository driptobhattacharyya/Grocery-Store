# Copy to .env (git-ignored) or set these in the Cloudflare build settings.
# Vite only exposes variables that start with VITE_ to the browser.

# Base URL of the Flask API, without a trailing slash, e.g.
#   https://grocery-store-api.onrender.com
# Leave empty to call the same origin (local dev through the Vite proxy to
# http://127.0.0.1:5000, and the Docker image where Flask serves the SPA).
VITE_API_BASE_URL=

# Cloudflare Turnstile *site* key (public). When set, the "Emails & jobs"
# panel shows the Turnstile widget and sends its token.
# Set this TOGETHER with the backend's TURNSTILE_SECRET_KEY (set on Render).
# The two keys must come from the same Turnstile widget, created for the
# hostname grocery-store.driptobhattacharyya.com.
# Without TURNSTILE_SECRET_KEY on the backend, production never sends real
# e-mail: it runs in preview mode only.
# Leave empty to skip the bot check.
VITE_TURNSTILE_SITE_KEY=

# Development only: serve a fake in-memory demo API from the Vite dev server
# (see dev-mock/). Never applies to `vite build`.
# VITE_DEMO_MOCK=true
